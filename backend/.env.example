# PostgreSQL connection string (Supabase: use the Transaction Pooler or Session Pooler URI)
# Example (pooler, port 6543): postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Example (direct, port 5432):  postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Port the Express server listens on
PORT=4000

# Allowed CORS origin for the frontend (use * to allow all, or a specific origin e.g. http://localhost:5173)
CORS_ORIGIN=*
